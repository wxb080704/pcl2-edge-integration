{
  "manifest_version": 3,
  "name": "PCL2 Downloader",
  "version": "1.0.0",
  "description": "使用 PCL2 多线程引擎接管 Edge 下载 — 分片加速、断点续传、自动重试",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "downloads.open",
    "storage",
    "notifications",
    "nativeMessaging",
    "cookies"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PCL2 Downloader"
  }
}
